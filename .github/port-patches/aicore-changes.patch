+  'parameter',
+  '>\n',
+  // </｜｜DSML｜｜invoke>
+  '</',
+  '｜｜DSML｜｜',
+  'inv',
+  'oke',
+  '>\n',
+  // <｜｜DSML｜｜invoke name="builtin_web_search">
+  '<',
+  '｜｜DSML｜｜',
+  'inv',
+  'oke',
+  ' name',
+  '="',
+  'built',
+  'in',
+  '_',
+  'web',
+  '_search',
+  '">\n',
+  // <｜｜DSML｜｜parameter name="additionalContext" string="true">
+  '<',
