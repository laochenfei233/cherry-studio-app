+  }
+}))
+
+vi.mock('@renderer/store/settings', () => ({
+  default: (state = { settings: {} }) => state
+}))
+
+vi.mock('@renderer/store/llm', () => ({
+  initialState: {},
+  default: (state = { llm: {} }) => state
+}))
+
