-function buildCommonOptions(ctx: BuilderContext) {
-  const options: Record<string, any> = {
-    headers: {
-      ...defaultAppHeaders(),
-      ...ctx.actualProvider.extra_headers
-    }
-  }
-  if (ctx.aiSdkProviderId === 'openai') {
-    options.headers['X-Api-Key'] = ctx.baseConfig.apiKey
-  }
-  return options
-}
