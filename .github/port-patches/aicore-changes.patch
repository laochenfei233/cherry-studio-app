+
+    it('extracts multiple DSML blocks within a single text part', async () => {
+      const text =
+        'lead-in ' +
+        '<｜｜DSML｜｜tool_calls>' +
+        '<｜｜DSML｜｜invoke name="search_a">' +
+        '<｜｜DSML｜｜parameter name="q" string="true">first</｜｜DSML｜｜parameter>' +
+        '</｜｜DSML｜｜invoke>' +
+        '</｜｜DSML｜｜tool_calls>' +
