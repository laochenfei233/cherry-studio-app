+  getReasoningEffort,
+  getXAIReasoningParams
+} from '../reasoning'
+
+function defaultGetStoreSetting<K extends keyof SettingsState>(key: K): SettingsState[K] {
+  if (key === 'openAI') {
+    return {
+      summaryText: 'auto',
+      verbosity: 'medium'
+    } as SettingsState[K]
+  }
+  return undefined as SettingsState[K]
+}
