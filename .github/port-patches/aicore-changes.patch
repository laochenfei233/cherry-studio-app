+    expect(concatenated).toBe('')
+  })
+
+  it('preserves plain text before and after the DSML block', async () => {
+    const deltas = ['让我先搜索一下。', ...SSE_DELTAS, '\n搜索完成。']
+    const events = await runStream(deltas, 'stop')
