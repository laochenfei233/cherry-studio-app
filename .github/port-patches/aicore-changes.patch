-      i18nKey: 'chat.no_api_key',
-      providerId: provider?.id
-    },
-    {
-      condition: () => error.error?.code === '1304' || /限额|免费配额|free quota|rate limit/i.test(error.message),
-      i18nKey: 'chat.quota_exceeded',
