+  'parameter',
+  '>\n',
+  // </｜｜DSML｜｜invoke>
+  '</',
+  '｜｜DSML｜｜',
+  'inv',
+  'oke',
+  '>\n',
+  // <｜｜DSML｜｜invoke name="builtin_web_search">
+  '<',
+  '｜｜DSML｜｜',
+  'inv',
+  'oke',
+  ' name',
+  '="',
+  'built',
+  'in',
+  '_',
