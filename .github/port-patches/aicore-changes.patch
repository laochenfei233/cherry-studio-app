+
+      const reconstructed = result.content
+        .filter((p: any) => p.type === 'text')
+        .map((p: any) => p.text)
+        .join('')
+      expect(reconstructed).toBe('lead-in  middle  tail')
+      expect(reconstructed).not.toContain('｜｜DSML｜｜')
