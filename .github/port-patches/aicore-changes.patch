-  RuntimeConfig<AppProviderSettingsMap, T>
-
-/**
- * 应用层运行时执行器 - 支持完整的 App provider IDs 和 settings
- */
-export type AppRuntimeExecutor = RuntimeExecutor<AppProviderSettingsMap>
