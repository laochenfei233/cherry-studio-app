+        '<｜｜DSML｜｜tool_calls>' +
+        '<｜｜DSML｜｜invoke name="search_b">' +
+        '<｜｜DSML｜｜parameter name="q" string="true">second</｜｜DSML｜｜parameter>' +
+        '</｜｜DSML｜｜invoke>' +
+        '</｜｜DSML｜｜tool_calls>' +
