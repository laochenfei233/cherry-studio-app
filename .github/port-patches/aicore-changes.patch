+        maxOutputTokens: 999999,
+        seed: 2147483647,
+        topK: 10000
+      }
+
+      const result = extractAiSdkStandardParams(customParams)
+
+      expect(result.standardParams).toStrictEqual({
+        maxOutputTokens: 999999,
+        seed: 2147483647,
+        topK: 10000
+      })
+      expect(result.providerParams).toStrictEqual({})
