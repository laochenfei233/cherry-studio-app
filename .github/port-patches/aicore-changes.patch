-          type: ChunkType.LLM_RESPONSE_COMPLETE,
-          response: {
-            ...baseResponse,
-            usage: { ...usage },
-            metrics: metrics ? { ...metrics } : undefined
-          }
-        })
-        this.resetTimingState()
